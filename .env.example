BASE_URL=https://hlssaleslist-webapp-stage.azurewebsites.net/
KEY_VAULT_URL=https://<vault-name>.vault.azure.net/
TEST_ENV=staging

# Every "<prefix><number>-password" secret in Key Vault becomes a test user; tests lease free users at run time
# through the `users` fixture. Copy this file to .env and never commit .env.
TEST_USER_POOL_PREFIX=saleslisttestuserstage
TEST_USER_POOL_DOMAIN=hamptonlumber.com
